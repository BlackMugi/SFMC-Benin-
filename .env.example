# === Copier vers .env (npm run init:env remplace les CHANGE_ME par des secrets aléatoires) ===
LOG_LEVEL=info

# --- Ports publiés sur la machine hôte (reverse proxy HTTPS) ---
HTTPS_PORT=8443
HTTP_PORT=8080

# --- JWT ---
JWT_SECRET=CHANGE_ME
JWT_ISSUER=sfmc-auth
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=7

# --- Broker ---
RABBITMQ_USER=sfmc
RABBITMQ_PASSWORD=CHANGE_ME

# --- Bases PostgreSQL (une par service) ---
AUTH_DB_PASSWORD=CHANGE_ME
USER_DB_PASSWORD=CHANGE_ME
PRODUCT_DB_PASSWORD=CHANGE_ME
INVENTORY_DB_PASSWORD=CHANGE_ME
ORDER_DB_PASSWORD=CHANGE_ME
PRODUCTION_DB_PASSWORD=CHANGE_ME
BILLING_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
REPORTING_DB_PASSWORD=CHANGE_ME

# --- OAuth2 client credentials ---
ORDER_CLIENT_SECRET=CHANGE_ME
PARTNER_DEMO_CLIENT_SECRET=CHANGE_ME

# --- Compte administrateur initial (créé par user-service) ---
ADMIN_EMAIL=admin@sfmc.bj
ADMIN_PASSWORD=CHANGE_ME

# --- Gateway ---
CORS_ORIGINS=https://localhost:8443,http://localhost:3000
GATEWAY_RATE_LIMIT=300
GATEWAY_AUTH_RATE_LIMIT=30

# --- Métier ---
SEED_DEMO_DATA=true
DEFAULT_WAREHOUSE_CODE=COTONOU
LEAD_TIME_DAYS=2
# Accélération de la simulation de production (120 = 2 min simulées par seconde réelle)
PRODUCTION_SPEED_FACTOR=120
# Contrôle qualité : délai simulé (s) et taux de lots non conformes (0 à 1)
QUALITY_CHECK_SECONDS=2
QUALITY_FAIL_RATE=0
MAX_WORK_ORDER_QTY=5000
TAX_RATE=0.18
CURRENCY=XOF
NOTIFICATION_PROVIDER=mock
ADMIN_NOTIFY_EMAIL=ops@sfmc.bj

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
