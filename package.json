{
  "name": "sfmc-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme microservices SFMC Bénin",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @sfmc/common && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "jest --config tests/integration/jest.config.js --runInBand",
    "init:env": "node scripts/init-env.mjs",
    "demo": "node scripts/demo.mjs",
    "up": "docker compose up --build -d",
    "down": "docker compose down",
    "load": "node scripts/load-test.mjs",
    "load:ha": "node scripts/load-test.mjs --kill order-service"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "js-yaml": "^5.4.3"
  }
}
